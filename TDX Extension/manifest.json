{
	"name": "TDX Description Viewer",
	"description": "Show Ticket Description",
	"version": "1.1",
	"permissions": [
		"activeTab", 
		"scripting",
		"storage",
		"tabs"
	],
	"manifest_version": 3,
	"action": {
		"default_popup": "popup.html"
	},
		"content_scripts": [
		{
		  "matches": ["<all_urls>"],
		  "js": ["content.js"],
		  "css": ["styles.css"],
		  "run_at": "document_idle"
		}
	]
}